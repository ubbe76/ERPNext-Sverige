msgstr "Serienummer {0} tillhör inte artikel {1}"

msgid "The shareholder does not belong to this company"
msgstr "Aktieägare tillhör inte detta bolag"

msgid "The stock for the item {0} in the {1} warehouse was negative on the {2}. You should create a positive entry {3} before the date {4} and time {5} to post the correct valuation rate. For more details, please read the <a href='https://docs.erpnext.com/docs/user/manual/en/stock-adjustment-cogs-with-negative-stock'>documentation<a>."
msgstr "Lager för artikel {0} i {1} lager var negativt {2}. Skapa positiv post {3} före {4} och {5} för att bokföra rätt värderingspris. För mer information, läs dokumentation <a href='https://docs.erpnext.com/docs/user/manual/en/stock-adjustment-cogs-with-negative-stock'><a>."

msgid "The stock has been reserved for the following Items and Warehouses, un-reserve the same to {0} the Stock Reconciliation: <br /><br /> {1}"
msgstr "Lager är reserverat för följande artiklar och lager, ta bort reservation till {0} lageravstämning: <br /><br /> {1}"

msgid "The system will attempt to automatically match a party to a bank transaction based on account number or IBAN."
msgstr "System kommer att försöka automatiskt stämma av part till banktransaktion baserat på kontonummer eller IBAN."

msgid "The system will create a Sales Invoice or a POS Invoice from the POS interface based on this setting. For high-volume transactions, it is recommended to use POS Invoice."
msgstr "System kommer att skapa försäljningsfaktura eller kassafaktura från kassan baserat på denna inställning. För transaktioner med stora volymer rekommenderas att kassafaktura används."

msgid "The task has been enqueued as a background job. In case there is any issue on processing in background, the system will add a comment about the error on this Stock Reconciliation and revert to the Draft stage"
msgstr "Uppgift är i kö som bakgrundsjobb. Om det finns problem med behandling i bakgrund kommer system att lägga till kommentar om fel i denna lageravstämning och återgå till utkaststeg"

msgid "The task has been enqueued as a background job. In case there is any issue on processing in background, the system will add a comment about the error on this Stock Reconciliation and revert to the Submitted stage"
msgstr "Uppgift är i kö som ett bakgrundsjobb. Om det finns några problem med bearbetning i bakgrund kommer system att lägga till kommentar om fel på denna lageravstämning och återgå till godkänt steg"

msgid "The total Issue / Transfer quantity {0} in Material Request {1}  cannot be greater than allowed requested quantity {2} for Item {3}"
msgstr "Totalt utfärdad/överförd kvantitet {0} i materialbegäran {1}  kan inte vara högre än tillåten begärd kvantitet {2} för artikel {3}"

msgid "The total Issue / Transfer quantity {0} in Material Request {1} cannot be greater than requested quantity {2} for Item {3}"
msgstr "Totalt utfärdad/överförd kvantitet {0} i materialbegäran {1} kan inte vara högre än begärd kvantitet {2} för artikel {3}"

msgid "The uploaded file does not match the selected Code List."
msgstr "Uppladdad fil stämmer inte överens med vald kodlista."

msgid "The user can create a new Item but cannot edit existing items."
msgstr "Användare kan skapa ny artikel men kan inte redigera befintliga artiklar."

msgid "The user can delete Draft / Cancelled documents."
msgstr "Användare kan ta bort utkast / annullerade dokument."

msgid "The user can select a Customer in Sales Order but cannot open the Customer master."
msgstr "Användare kan välja kund i försäljningsorder men kan inte öppna kundinställningar."

msgid "The user can update a customer or any other fields in an existing Sales Order but cannot create a new Sales Order."
msgstr "Användare kan uppdatera kund eller andra fält i befintlig försäljningsorder men kan inte skapa ny försäljningsorder."

msgid "The user can view Sales Invoices but cannot modify any field values in them."
msgstr "Användare kan visa försäljningsfakturor men kan inte ändra några fältvärden."

