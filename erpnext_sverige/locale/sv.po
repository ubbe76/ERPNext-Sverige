msgstr "Standardstycklista för artikel kommer att hämtas av systemet. Man kan också ändra stycklistan."

msgid "The default value for the Check field {0} must be either '0' or '1'"
msgstr "Standardvärdet för kontrollfältet {0} måste vara antingen '0' eller '1'"

msgid "The difference between from time and To Time must be a multiple of Appointment"
msgstr "Differens mellan från tid och till tid måste vara flera tider"

