msgstr "Tillgångskontofältet kan inte vara tomt"

msgid "The field Equity/Liability Account cannot be blank"
msgstr "Kontofältet för eget kapital/skuld kan inte vara tomt"

msgid "The field From Shareholder cannot be blank"
msgstr "Fältet från aktieägare kan inte vara tomt"

msgid "The field To Shareholder cannot be blank"
msgstr "Fältet till aktieägare kan inte vara tomt"

